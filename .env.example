# Claude API (default provider)
ANTHROPIC_API_KEY=
# Or run on Amazon Bedrock with AWS credentials / an IAM role instead:
# CARESIGNAL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# Or use Google Gemini (has a free tier; key from Google AI Studio):
# CARESIGNAL_PROVIDER=gemini
# GEMINI_API_KEY=
# CARESIGNAL_GEMINI_MODEL=gemini-flash-latest
# Optional overrides
# CARESIGNAL_MODEL=claude-opus-5-5
# CARESIGNAL_CORS_ORIGINS=http://localhost:5173
